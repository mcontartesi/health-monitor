# Local secrets template for Wrangler (.dev.vars)
# Copy this file to .dev.vars for local testing.
# DO NOT COMMIT .dev.vars TO GIT!

# Admin Portal Credentials (Fallback protection when Cloudflare Access is not active)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin"

# Production Secret Override via Wrangler CLI:
# npx wrangler secret put ADMIN_PASSWORD
