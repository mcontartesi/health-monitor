{
  "name": "health-monitor",
  "version": "1.0.0",
  "description": "100% Cloudflare Workers native cron job and service health monitoring platform",
  "main": "src/worker/index.ts",
  "type": "module",
  "scripts": {
    "dev": "npx vite",
    "build": "npx vite build",
    "deploy": "npm run build && npx wrangler deploy",
    "db:setup": "npx wrangler d1 execute DB --file=./schema.sql",
    "db:setup:local": "npx wrangler d1 execute DB --local --file=./schema.sql",
    "test": "vitest run"
  },
  "keywords": [
    "healthchecks",
    "cronjob-monitoring",
    "cloudflare-workers",
    "cloudflare-d1",
    "uptime-monitoring",
    "dead-man-switch",
    "monitoring"
  ],
  "author": "Health Monitor Open Source Community",
  "license": "MIT",
  "dependencies": {
    "hono": "^4.6.0",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^3.84.0"
  }
}
